# LLM Provider API Key (Set both for automatic cross-provider RAGAS judging)
# Google Gemini API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Or OpenAI API key:
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: override generator / independent judge models or document folder
# GEMINI_MODEL_NAME=gemini-3.5-flash-lite
# JUDGE_GEMINI_MODEL_NAME=gemini-3.5-flash
# DATA_DIR=path/to/your/pdf_folder
